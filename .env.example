# Export these in your shell (nothing here is loaded automatically). Only needed for a real LLM step.
# HEAL_LLM=mock            # mock (default) | openai | azure | bedrock | off

# OpenAI
# OPENAI_API_KEY=
# HEAL_LLM_MODEL=gpt-4.1-mini

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Amazon Bedrock (also run: npm install @aws-sdk/client-bedrock-runtime)
# AWS_REGION=eu-west-2
# BEDROCK_MODEL_ID=
